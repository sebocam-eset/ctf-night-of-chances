# Render static-site rewrites (copied to dist/ at build time).
# Backend routes must come before the SPA fallback; rules are matched top-down.
# Rewrites (status 200) keep the browser on this origin so the session cookie stays first-party.
/api/*                 https://ctf-ai-hub-v1.onrender.com/api/:splat           200
/login                 https://ctf-ai-hub-v1.onrender.com/login                200
/logout                https://ctf-ai-hub-v1.onrender.com/logout               200
/robots.txt            https://ctf-ai-hub-v1.onrender.com/robots.txt           200
/backup/*              https://ctf-ai-hub-v1.onrender.com/backup/:splat        200
/docs                  https://ctf-ai-hub-v1.onrender.com/docs                 200
/openapi.json          https://ctf-ai-hub-v1.onrender.com/openapi.json         200
/*                     /index.html                                             200
